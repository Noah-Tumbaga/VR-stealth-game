; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Shadowveil - VR Stealth"
config/description="A silent-assassin VR stealth game. Sneak, strike from the shadows, and bend the dark to your will."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=0

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"

[navigation]

3d/default_cell_size=0.2
3d/default_cell_height=0.1
3d/merge_rasterizer_cell_scale=0.001

[physics]

common/physics_ticks_per_second=90
common/physics_jitter_fix=0.0

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/positional_shadow/atlas_size=4096
environment/defaults/default_clear_color=Color(0.02, 0.025, 0.05, 1)

[xr]

openxr/enabled=true
openxr/startup_alert=false
openxr/foveation_level=2
shaders/enabled=true
